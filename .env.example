# ===== CekDulu API =====
# Mode: development | test | production
CEKDULU_ENV=development
CEKDULU_LOG_LEVEL=INFO
CEKDULU_LOG_JSON=true

# Wajib di production (min. 24 karakter). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CEKDULU_API_KEYS=
CEKDULU_HASH_SECRET=
CEKDULU_RATE_LIMIT_PER_MINUTE=30
CEKDULU_CORS_ORIGINS=
CEKDULU_MAX_UPLOAD_MB=5

# Model: sklearn (default, CPU, ~2 ms/pesan) atau transformers (IndoBERT dari scripts/train_indobert.py)
CEKDULU_CLASSIFIER_BACKEND=sklearn
CEKDULU_MODEL_DIR=models/baseline
# Kosongkan agar memakai threshold hasil tuning di metadata.json
# CEKDULU_FRAUD_THRESHOLD=0.37

# LLM opsional (OCR screenshot + penjelasan bahasa awam). Tanpa LLM sistem tetap berjalan.
# Provider: none | gemini | openai
CEKDULU_LLM_PROVIDER=none
CEKDULU_LLM_API_KEY=
# Beberapa kandidat dipisah koma; bila model pertama 404 (deprecated), berikutnya dicoba.
# Cek nama model terbaru di dokumentasi provider sebelum deploy.
CEKDULU_LLM_MODELS=gemini-2.5-flash
CEKDULU_LLM_BASE_URL=https://api.openai.com/v1

CEKDULU_OCR_TESSERACT=true
CEKDULU_OCR_TESSERACT_LANG=ind+eng

# Token dari @BotFather (untuk mengunduh foto dari Telegram & mode poller)
CEKDULU_TELEGRAM_BOT_TOKEN=

CEKDULU_DATABASE_URL=sqlite:///./var/cekdulu.db
# true hanya dengan persetujuan eksplisit pengguna (UU PDP)
CEKDULU_STORE_RAW_TEXT=false
CEKDULU_REPORT_TTL_HOURS=24

# ===== n8n (docker compose) =====
# URL HTTPS publik yang meneruskan ke port 5678 (mis. ngrok http 5678)
N8N_WEBHOOK_URL=https://xxxx.ngrok-free.app/
# Salah satu nilai dari CEKDULU_API_KEYS
CEKDULU_N8N_API_KEY=
