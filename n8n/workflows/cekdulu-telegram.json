{
  "name": "CekDulu - Telegram Bot",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "cekdulu-telegram-webhook",
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram CekDulu" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CEKDULU_API_URL }}/v1/telegram/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.CEKDULU_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 45000 }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000002",
      "name": "CekDulu API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.reply_text }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000003",
      "name": "Kirim Balasan",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 200],
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram CekDulu" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Maaf, layanan CekDulu sedang sibuk. Coba lagi 1 menit lagi. Jika Anda baru saja transfer ke penipu, SEGERA telepon call center resmi bank Anda.",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000004",
      "name": "Kirim Pesan Gagal",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 420],
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram CekDulu" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1a1b2c3-0000-4000-8000-000000000001",
              "leftValue": "={{ $('CekDulu API').item.json.report_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000005",
      "name": "Ada Laporan PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.CEKDULU_API_URL }}/v1/reports/{{ $('CekDulu API').item.json.report_id }}.pdf",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.CEKDULU_API_KEY }}" }]
        },
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } }
        }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000006",
      "name": "Unduh PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 120]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": { "caption": "Laporan kronologi untuk bank & IASC OJK" }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000007",
      "name": "Kirim PDF",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 120],
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram CekDulu" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1a1b2c3-0000-4000-8000-000000000002",
              "leftValue": "={{ $('CekDulu API').item.json.schedule_reminder }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000008",
      "name": "Perlu Pengingat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 120]
    },
    {
      "parameters": { "amount": 15, "unit": "minutes" },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000009",
      "name": "Tunggu 15 Menit",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1680, 40],
      "webhookId": "cekdulu-reminder-wait"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "⏰ <b>Pengingat golden hour</b>\nSudah 15 menit. Pastikan Anda sudah:\n1. Menelepon call center RESMI bank dan mendapat nomor tiket pengaduan.\n2. Mengisi laporan di https://iasc.ojk.go.id (lampirkan PDF dari CekDulu).\nJika belum, lakukan SEKARANG.",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      },
      "id": "5f0c6a8e-1b11-4c51-9a10-000000000010",
      "name": "Kirim Pengingat",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1920, 40],
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram CekDulu" }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "CekDulu API", "type": "main", "index": 0 }]] },
    "CekDulu API": {
      "main": [
        [{ "node": "Kirim Balasan", "type": "main", "index": 0 }],
        [{ "node": "Kirim Pesan Gagal", "type": "main", "index": 0 }]
      ]
    },
    "Kirim Balasan": { "main": [[{ "node": "Ada Laporan PDF?", "type": "main", "index": 0 }]] },
    "Ada Laporan PDF?": { "main": [[{ "node": "Unduh PDF", "type": "main", "index": 0 }], []] },
    "Unduh PDF": { "main": [[{ "node": "Kirim PDF", "type": "main", "index": 0 }]] },
    "Kirim PDF": { "main": [[{ "node": "Perlu Pengingat?", "type": "main", "index": 0 }]] },
    "Perlu Pengingat?": { "main": [[{ "node": "Tunggu 15 Menit", "type": "main", "index": 0 }], []] },
    "Tunggu 15 Menit": { "main": [[{ "node": "Kirim Pengingat", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "active": false
}
